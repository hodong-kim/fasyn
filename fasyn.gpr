with "fasyn_config.gpr";

library project Fasyn is

  for Source_Dirs use ("src");
  for Object_Dir use
    "build/obj/" & Fasyn_Config.Target_Name & "/" &
    Fasyn_Config.Artifact_Profile_Name & "/core";
  for Library_Dir use
    "build/lib/" & Fasyn_Config.Target_Name & "/" &
    Fasyn_Config.Artifact_Profile_Name;
  for Library_Name use "fasyn";
  for Library_Kind use "static-pic";

  package Compiler is
    for Default_Switches ("Ada") use
      Fasyn_Config.Ada_Switches;
  end Compiler;

end Fasyn;
