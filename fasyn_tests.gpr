with "fasyn";
with "fasyn_config.gpr";
with "fasyn_runtime.gpr";
with "clair_config.gpr";

project Fasyn_Tests is

  for Languages use ("Ada", "C");
  for Source_Dirs use
    ("tests", "tests/native",
     "build/gen/" & Fasyn_Config.Target_Name & "/" &
       Fasyn_Config.Artifact_Profile_Name & "/tests");
  for Object_Dir use
    "build/obj/" & Fasyn_Config.Target_Name & "/" &
    Fasyn_Config.Artifact_Profile_Name & "/tests";
  for Exec_Dir use
    "build/bin/" & Fasyn_Config.Target_Name & "/" &
    Fasyn_Config.Artifact_Profile_Name & "/tests";
  for Create_Missing_Dirs use "True";
  for Main use
    ("fasyn_unit_tests.adb",
     "fasyn_classic_fixture.adb",
     "fasyn_nginx_fixture.adb",
     "fasyn_execution_lifecycle_tests.adb",
     "fasyn_exchange_callback_churn_fixture.adb");

  package Compiler is
    for Default_Switches ("Ada") use
      ("-gnat2022", "-gnatwa", "-gnatW8", "-gnatwe", "-O0");
    for Default_Switches ("C") use ("-Werror");
  end Compiler;

  package Linker renames Clair_Config.Linker;

end Fasyn_Tests;
