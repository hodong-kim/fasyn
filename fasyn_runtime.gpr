with "fasyn";
with "clair.gpr";
with "clair_config.gpr";

project Fasyn_Runtime is

  for Languages use ("Ada");
  for Source_Dirs use ("src/runtime");
  for Object_Dir use "build/runtime/obj";
  for Create_Missing_Dirs use "True";

  package Compiler is
    for Default_Switches ("Ada") use
      ("-gnat2022", "-gnatwa", "-gnatW8", "-gnatwe", "-O2");
  end Compiler;

  package Linker renames Clair_Config.Linker;

end Fasyn_Runtime;
