with "fasyn";
with "fasyn_config.gpr";
with "clair.gpr";
with "clair_config.gpr";

project Fasyn_Runtime is

  for Languages use ("Ada");
  for Source_Dirs use ("src/runtime");
  for Object_Dir use
    "build/obj/" & Fasyn_Config.Target_Name & "/" &
    Fasyn_Config.Artifact_Profile_Name & "/runtime";
  for Create_Missing_Dirs use "True";

  package Compiler is
    for Default_Switches ("Ada") use
      Fasyn_Config.Ada_Switches;
  end Compiler;

  package Linker renames Clair_Config.Linker;

end Fasyn_Runtime;
